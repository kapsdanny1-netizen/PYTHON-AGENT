################################################################################
# EnergyForge Agent — environment configuration
#
# Copy to `.env` and fill in:   cp .env.example .env
#
# Convention: every variable maps 1:1 to a field in config/settings.py
# (case-insensitive). Variables marked REQUIRED must be set for the marked
# condition; everything else ships with a working development default.
################################################################################

# ── Core ──────────────────────────────────────────────────────────────────────
# ENVIRONMENT: dev | test | prod
#   dev  → notifications print to console, HITL approvals read from stdin
#   prod → notifications go to Slack webhook, HITL approvals route to webhook
# Default: dev
ENVIRONMENT=dev

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR — output is always JSON lines.
# Default: INFO
LOG_LEVEL=INFO

# RANDOM_SEED: seed for the synthetic sensor generators (data/generators.py).
# Set to any integer for deterministic, reproducible demo data. Default: 42
RANDOM_SEED=42

# ── LLM provider ─────────────────────────────────────────────────────────────
# LLM_PROVIDER: THE single switch for the backend — one of:
#   openai    → OpenAI API (default model gpt-4o)
#   anthropic → Anthropic API (default model claude-sonnet-4-20250514)
#   grok      → xAI Grok via OpenAI-compatible endpoint (default model grok-3)
#   ollama    → local Ollama, no API key needed (default model llama3.1:8b)
# Default: openai
LLM_PROVIDER=openai

# LLM_MODEL: optional override for the provider default model (useful for
# cheaper runs, e.g. gpt-4o-mini or llama3.1:70b). Default: provider default
#LLM_MODEL=

# LLM_TEMPERATURE: 0.0–2.0. Low temperature = deterministic ops decisions.
# Default: 0.1
LLM_TEMPERATURE=0.1

# LLM_MAX_TOKENS: completion budget per LLM call. Default: 2048
LLM_MAX_TOKENS=2048

# LLM_REQUEST_TIMEOUT_S: per-call timeout in seconds. Default: 60
LLM_REQUEST_TIMEOUT_S=60

# REQUIRED when LLM_PROVIDER=openai. Get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL: override only for proxies / Azure-compatible gateways.
#OPENAI_BASE_URL=https://api.openai.com/v1

# REQUIRED when LLM_PROVIDER=anthropic. Get one: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# REQUIRED when LLM_PROVIDER=grok. Get one: https://console.x.ai/
GROK_API_KEY=
#GROK_BASE_URL=https://api.x.ai/v1

# LLM_PROVIDER=ollama needs NO key. Just run: ollama pull llama3.1:8b
# Point this at a remote Ollama host if it isn't local.
OLLAMA_BASE_URL=http://localhost:11434

# ── TimescaleDB (PostgreSQL 16 + TimescaleDB extension) ──────────────────────
# These four MUST stay in sync with the `db` service in docker-compose.yml.
POSTGRES_HOST=localhost        # the app service overrides this to `db` in-compose
POSTGRES_PORT=5432
POSTGRES_USER=energyforge
# REQUIRED — change this for anything beyond throwaway local dev.
POSTGRES_PASSWORD=energyforge
POSTGRES_DB=energyforge

# Async connection pool sizing for SQLAlchemy.
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10

# ── ChromaDB vector store (long-term semantic memory: manuals + RCAs) ────────
CHROMA_HOST=localhost          # the app service overrides this to `chroma` in-compose
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=energyforge_memory

# ── Redis (task queue / cache / HITL approval channel) ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Notifications ────────────────────────────────────────────────────────────
# REQUIRED in prod (NotificationTool refuses Slack mode without it).
# In dev/test, notifications are rendered to the console instead.
SLACK_WEBHOOK_URL=
NOTIFICATION_CHANNEL=#energyforge-ops

# ── Governance / orchestration limits ────────────────────────────────────────
# HITL_CONFIDENCE_THRESHOLD: the HITL gate pauses the graph for human approval
# when any agent output's confidence is below this value (0–1). Default: 0.75
HITL_CONFIDENCE_THRESHOLD=0.75

# MAX_LLM_CALLS_PER_TURN: hard cap on LLM calls per orchestrator turn.
# Tool calls are unlimited. Default: 3
MAX_LLM_CALLS_PER_TURN=3

# TOOL_TIMEOUT_S: per-tool execution timeout guard. Default: 30
TOOL_TIMEOUT_S=30
